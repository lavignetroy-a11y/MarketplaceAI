OPENAI_API_KEY=sk-...

# Optional overrides -- image generation defaults to gpt-image-2. If that model isn't available
# on your account (or doesn't exist), set this to gpt-image-1 or another supported value.
# OPENAI_IMAGE_MODEL=gpt-image-2

# Optional override for the vision/analysis model (defaults to gpt-4o).
# OPENAI_TEXT_MODEL=gpt-4o
