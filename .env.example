# ---------------------------------------------------------------------------
# OpenAI -- required for image analysis and generation
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Optional overrides. Image generation defaults to gpt-image-2; if that isn't available on
# your account, set this to gpt-image-1.
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_TEXT_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Supabase -- required for accounts and saved campaign history.
# Without these the site still runs; campaigns just aren't persisted and the
# account pages show a "not configured" state instead of crashing.
#
# Find these in your Supabase project under Settings -> API.
# Run supabase/migrations/0001_init.sql once in the SQL Editor first.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ -- it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---------------------------------------------------------------
# Test-mode keys are fine to start.
#
# STRIPE_SECRET_KEY   Dashboard -> Developers -> API keys -> Secret key (sk_test_...)
#
# STRIPE_WEBHOOK_SECRET  comes from a DIFFERENT place depending on where the app is running:
#   locally      `stripe listen --print-secret`. Stripe cannot reach localhost, so the CLI
#                tunnels events in and mints its own secret. Restarting the tunnel mints a new
#                one, so this has to be updated and the dev server restarted when it does.
#   deployed     Dashboard -> Developers -> Webhooks, on the endpoint you register there. The
#                CLI's secret will not work against a deployed app and vice versa.
#
# While these are unset the app falls back to a development bypass that marks a campaign paid
# without charging. Setting them switches real payment on AND disables that bypass.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where Stripe returns the buyer to. Must be the public URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact -- REQUIRED BEFORE LAUNCH
#
# The refund policy, the terms, the acceptable-use page and the contact page all point at these.
# Left unset they fall back to example.com, which means a paying customer's complaint goes to a
# domain nobody owns and no error appears anywhere.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_ABUSE_EMAIL=

# ---------------------------------------------------------------------------
# Email -- how a buyer is told their set is finished
#
# Without these the app still works: the seller sees their images on the page. But anyone who
# closes the tab before downloading has no way back to what they paid for, and no way to know it
# ever finished.
#
# Sign up at resend.com, verify a sending domain, and paste the API key. EMAIL_FROM must be on a
# domain you verified there; the default below is Resend's shared test sender, which delivers to
# your own address only and is fine until you have a domain.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Marketplace / AI <onboarding@resend.dev>
