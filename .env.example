# ---------------------------------------------------------------------------
# OpenAI -- required for image analysis and generation
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Optional overrides. Image generation defaults to gpt-image-2; if that isn't available on
# your account, set this to gpt-image-1.
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_TEXT_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Supabase -- required for accounts and saved campaign history.
# Without these the site still runs; campaigns just aren't persisted and the
# account pages show a "not configured" state instead of crashing.
#
# Find these in your Supabase project under Settings -> API.
# Run supabase/migrations/0001_init.sql once in the SQL Editor first.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ -- it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
